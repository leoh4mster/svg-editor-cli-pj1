# 题目 §6 完整会话。请从工程根目录运行。
# 预期 stderr 恰好两行：祖先/后代同时分组失败、save 后禁止 undo。
init 800 600
create rect bg 0 0 800 600 #ffffff
create text title 20 40 "My Diagram"
create circle c1 100 100 20 red
create rect box 200 80 60 60 #3366ff

group markers c1 box
tree
move c1 30 0
undo
redo
set title text "My Diagram v2"
undo
group bad c1 markers
delete box
undo
save examples/output/demo.svg
undo

# examples/imported.svg 即题目中的 other.svg；只改路径，不改内容。
read examples/imported.svg
tree

# 在完整会话之后另存导入结果，方便核对 7 元素和自动补 ID。
save examples/output/imported-copy.svg
